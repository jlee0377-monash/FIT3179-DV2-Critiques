{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "title": {
    "text": "State-level categorical distribution map",
    "subtitle": "Categorical mapping with names and counts shown in black.",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "anchor": "start"
  },
  "projection": {
    "type": "mercator",
    "center": [133, -27],
    "scale": 600
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f8fafc",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "values": [
          {"State": "New South Wales", "Code": "NSW", "MarketCount": 15, "longitude": 147.0, "latitude": -32.0},
          {"State": "Victoria", "Code": "VIC", "MarketCount": 13, "longitude": 144.5, "latitude": -36.8},
          {"State": "South Australia", "Code": "SA", "MarketCount": 3, "longitude": 135.5, "latitude": -30.5},
          {"State": "Western Australia", "Code": "WA", "MarketCount": 3, "longitude": 122.0, "latitude": -25.0},
          {"State": "Queensland", "Code": "QLD", "MarketCount": 2, "longitude": 144.0, "latitude": -22.5},
          {"State": "Tasmania", "Code": "TAS", "MarketCount": 2, "longitude": 146.6, "latitude": -42.0},
          {"State": "Australian Capital Territory", "Code": "ACT", "MarketCount": 1, "longitude": 149.1, "latitude": -35.3}
        ]
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "shape": "diamond"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "color": {
          "field": "State",
          "type": "nominal",
          "title": "State/Territory",
          "scale": {"scheme": "tableau10"}
        },
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {"field": "MarketCount", "type": "quantitative", "title": "Markets"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"Label": "NSW (15)", "longitude": 147.0, "latitude": -34.5},
          {"Label": "VIC (13)", "longitude": 144.5, "latitude": -39.2},
          {"Label": "SA (3)", "longitude": 135.5, "latitude": -33.0},
          {"Label": "WA (3)", "longitude": 122.0, "latitude": -27.5},
          {"Label": "QLD (2)", "longitude": 144.0, "latitude": -25.0},
          {"Label": "TAS (2)", "longitude": 146.6, "latitude": -44.5},
          {"Label": "ACT (1)", "longitude": 149.1, "latitude": -37.8}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#1e293b"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "Label", "type": "nominal"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}