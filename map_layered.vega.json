{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "title": {
    "text": "A geographic snapshot of the directory",
    "subtitle": "Layered symbol with names and counts shown in black.",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "anchor": "start"
  },
  "projection": {
    "type": "mercator",
    "center": [133, -27],
    "scale": 600
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#94a3b8",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "values": [
          {"State": "New South Wales", "Code": "NSW", "longitude": 147.0, "latitude": -32.0, "MarketCount": 15},
          {"State": "Victoria", "Code": "VIC", "longitude": 144.5, "latitude": -36.8, "MarketCount": 13},
          {"State": "South Australia", "Code": "SA", "longitude": 135.5, "latitude": -30.5, "MarketCount": 3},
          {"State": "Western Australia", "Code": "WA", "longitude": 122.0, "latitude": -25.0, "MarketCount": 3},
          {"State": "Queensland", "Code": "QLD", "longitude": 144.0, "latitude": -22.5, "MarketCount": 2},
          {"State": "Tasmania", "Code": "TAS", "longitude": 146.6, "latitude": -42.0, "MarketCount": 2},
          {"State": "Australian Capital Territory", "Code": "ACT", "longitude": 149.1, "latitude": -35.3, "MarketCount": 1}
        ]
      },
      "mark": {
        "type": "circle",
        "color": "#1e3a8a",
        "opacity": 0.75
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "MarketCount",
          "type": "quantitative",
          "title": "Count",
          "scale": {"range": [80, 500]}
        },
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {"field": "MarketCount", "type": "quantitative"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"Label": "NSW (15)", "longitude": 147.0, "latitude": -32.0},
          {"Label": "VIC (13)", "longitude": 144.5, "latitude": -36.8},
          {"Label": "SA (3)", "longitude": 135.5, "latitude": -30.5},
          {"Label": "WA (3)", "longitude": 122.0, "latitude": -25.0},
          {"Label": "QLD (2)", "longitude": 144.0, "latitude": -22.5},
          {"Label": "TAS (2)", "longitude": 146.6, "latitude": -42.0},
          {"Label": "ACT (1)", "longitude": 149.1, "latitude": -35.3}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#1e293b",
        "dy": 14
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "Label", "type": "nominal"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}