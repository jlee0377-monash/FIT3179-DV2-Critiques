{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "title": {
    "text": "Market counts by state: Proportional symbol map",
    "subtitle": "Circle area scales with listed market counts, showing names and counts in black.",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "anchor": "start"
  },
  "projection": {
    "type": "mercator",
    "center": [133, -27],
    "scale": 600
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f8fafc",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "values": [
          {"State": "NSW", "Label": "NSW (15)", "longitude": 147.0, "latitude": -32.0, "MarketCount": 15},
          {"State": "VIC", "Label": "VIC (13)", "longitude": 144.5, "latitude": -36.8, "MarketCount": 13},
          {"State": "SA", "Label": "SA (3)", "longitude": 135.5, "latitude": -30.5, "MarketCount": 3},
          {"State": "WA", "Label": "WA (3)", "longitude": 122.0, "latitude": -25.0, "MarketCount": 3},
          {"State": "QLD", "Label": "QLD (2)", "longitude": 144.0, "latitude": -22.5, "MarketCount": 2},
          {"State": "TAS", "Label": "TAS (2)", "longitude": 146.6, "latitude": -42.0, "MarketCount": 2},
          {"State": "ACT", "Label": "ACT (1)", "longitude": 149.1, "latitude": -35.3, "MarketCount": 1}
        ]
      },
      "mark": {
        "type": "circle",
        "opacity": 0.65,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "MarketCount",
          "type": "quantitative",
          "title": "Markets",
          "scale": {"range": [80, 600]}
        },
        "color": {"value": "#28634b"},
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {"field": "MarketCount", "type": "quantitative", "title": "Markets"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"State": "NSW", "Label": "NSW (15)", "longitude": 147.0, "latitude": -32.0, "MarketCount": 15},
          {"State": "VIC", "Label": "VIC (13)", "longitude": 144.5, "latitude": -36.8, "MarketCount": 13},
          {"State": "SA", "Label": "SA (3)", "longitude": 135.5, "latitude": -30.5, "MarketCount": 3},
          {"State": "WA", "Label": "WA (3)", "longitude": 122.0, "latitude": -25.0, "MarketCount": 3},
          {"State": "QLD", "Label": "QLD (2)", "longitude": 144.0, "latitude": -22.5, "MarketCount": 2},
          {"State": "TAS", "Label": "TAS (2)", "longitude": 146.6, "latitude": -42.0, "MarketCount": 2},
          {"State": "ACT", "Label": "ACT (1)", "longitude": 149.1, "latitude": -35.3, "MarketCount": 1}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#1e293b",
        "dy": 14
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "Label", "type": "nominal"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}