{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "title": {
    "text": "How does event activity change over time?",
    "subtitle": "Daily event-record counts."
  },
  "data": {
    "url": "brisbane-markets.csv"
  },
  "transform": [
    {
      "calculate": "timeParse(datum['Start Date'], '%m/%d/%Y')",
      "as": "ParsedDate"
    },
    {
      "filter": "isValid(datum.ParsedDate)"
    },
    {
      "timeUnit": "yearmonth",
      "field": "ParsedDate",
      "as": "Month"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Events"
        }
      ],
      "groupby": [
        "Month"
      ]
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "size": 35
    },
    "strokeWidth": 2,
    "color": "#C49A50"
  },
  "encoding": {
    "x": {
      "field": "ParsedDate",
      "type": "temporal",
      "title": "Event date"
    },
    "y": {
      "field": "Events",
      "type": "quantitative",
      "title": "Event records per date"
    },
    "tooltip": [
      {
        "field": "ParsedDate",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "Events",
        "type": "quantitative"
      }
    ]
  },
  "config": {
    "axis": {
      "labelColor": "#596579",
      "titleColor": "#6C5AA8",
      "gridColor": "#E4EAF3"
    },
    "legend": {
      "labelColor": "#596579",
      "titleColor": "#6C5AA8"
    },
    "title": {
      "color": "#6C5AA8",
      "subtitleColor": "#596579",
      "font": "Arial",
      "subtitleFont": "Arial"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "size": 65
        },
        "strokeWidth": 2,
        "color": "#9B8AD4"
      },
      "encoding": {
        "x": {
          "field": "Month",
          "type": "temporal",
          "title": "Month",
          "axis": {
            "format": "%b %Y",
            "labelAngle": -35
          }
        },
        "y": {
          "field": "Events",
          "type": "quantitative",
          "title": "Event records per month"
        },
        "tooltip": [
          {
            "field": "Month",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "field": "Events",
            "type": "quantitative",
            "title": "Event records"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -12,
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#9B8AD4"
      },
      "encoding": {
        "x": {
          "field": "Month",
          "type": "temporal"
        },
        "y": {
          "field": "Events",
          "type": "quantitative"
        },
        "text": {
          "field": "Events",
          "type": "quantitative"
        }
      }
    }
  ]
}