{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "title": {
    "text": "Brisbane Markets: Operational Mentions by Type",
    "subtitle": "Proportional donut chart summarizing operational shares.",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "anchor": "start"
  },
  "data": {
    "values": [
      {"MarketType": "Artisan & Craft", "Mentions": 18},
      {"MarketType": "Community Produce", "Mentions": 12},
      {"MarketType": "Night & Night Food", "Mentions": 9},
      {"MarketType": "Specialty Harvest", "Mentions": 6}
    ]
  },
  "transform": [
    {"window": [{"op": "sum", "field": "Mentions", "as": "Total"}], "frame": [null, null]},
    {"calculate": "datum.Mentions / datum.Total", "as": "Fraction"},
    {"calculate": "format(datum.Fraction, '.0%')", "as": "PercentageLabel"},
    {
      "stack": "Mentions",
      "sort": [{"field": "Mentions", "order": "descending"}],
      "as": ["v1", "v2"]
    },
    {"calculate": "(datum.v1 + datum.v2) / 2", "as": "midpoint"}
  ],
  "layer": [
    {
      "mark": {"type": "arc", "innerRadius": 75, "outerRadius": 120, "stroke": "#ffffff", "strokeWidth": 2},
      "encoding": {
        "theta": {"field": "Mentions", "type": "quantitative", "stack": true, "sort": {"field": "Mentions", "order": "descending"}},
        "color": {
          "field": "MarketType",
          "type": "nominal",
          "title": "Market Type",
          "scale": {"scheme": "tableau10"},
          "sort": {"field": "Mentions", "order": "descending"}
        },
        "tooltip": [
          {"field": "MarketType", "type": "nominal", "title": "Market Type"},
          {"field": "Mentions", "type": "quantitative", "title": "Mentions"},
          {"field": "PercentageLabel", "type": "nominal", "title": "Share"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": 98,
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#ffffff",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "theta": {"field": "midpoint", "type": "quantitative"},
        "text": {"field": "PercentageLabel", "type": "nominal"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}